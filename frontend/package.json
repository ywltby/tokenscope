{
  "name": "tokenscope-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "format": "prettier --write \"src/**/*.{ts,vue,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,json}\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "echarts": "^6.1.0",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^8.3.2",
    "vue-tsc": "^3.3.12"
  }
}
