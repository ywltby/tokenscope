#!/bin/sh
# TokenScope 提交门禁（启用：git config core.hooksPath .githooks）
# 计划 A5（F09）：根库与 Tauri 壳是两个独立 workspace（根 Cargo.toml
# exclude src-tauri），根命令不覆盖壳——两个 manifest 必须显式分别门禁。
set -e
# rustup 默认安装位置兜底：Git Bash / 某些钩子环境可能不继承用户 PATH
PATH="$HOME/.cargo/bin:$PATH"
export PATH
echo "[pre-commit] 根库 cargo fmt --check"
cargo fmt --all -- --check
echo "[pre-commit] 根库 cargo clippy"
cargo clippy --workspace --all-targets -- -D warnings
echo "[pre-commit] 根库 cargo test"
cargo test --workspace --quiet
echo "[pre-commit] 壳 cargo fmt --check"
cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check
echo "[pre-commit] 壳 cargo clippy"
cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings
echo "[pre-commit] 壳 cargo test"
cargo test --manifest-path src-tauri/Cargo.toml --quiet
echo "[pre-commit] frontend typecheck"
pnpm --dir frontend typecheck
echo "[pre-commit] frontend format:check"
pnpm --dir frontend format:check
echo "[pre-commit] frontend test"
pnpm --dir frontend test
