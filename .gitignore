# ── Rust / Cargo 构建产物 ───────────────────────────────
debug
target
# rustfmt 生成的备份文件
**/*.rs.bk
# MSVC Windows 构建产生的调试信息
*.pdb
# cargo llvm-cov 覆盖率原始数据与报告
*.profraw
coverage.*
# cargo mutants 变异测试数据
**/mutants.out*/
# rustc 遇到内部编译器错误时转储到当前目录的栈回溯
rustc-ice-*.txt

# ── 凭证与真实数据（永不提交）─────────────────────────
# 真实 agent 会话日志/用量导出可能含对话与代码内容；测试一律用合成 fixture
*.local
*.key
*.pem

# ── IDE / OS / 工具 ─────────────────────────────────────
.idea/
.vscode/
.claude/
.DS_Store
Thumbs.db
# ZCode 工具忽略文件（内容自动同步自 .gitignore，属工具产物）
.zcodeignore
# WorkBuddy / CodeBuddy agent 工作区数据（记忆、技能、会话状态）——工具产物
.workbuddy-ai/
# WorkBuddy 生成目录（当前可能尚未出现，预留忽略）
.workbuddy/

# ── GUI（Tauri + Vue）───────────────────────────────────
frontend/node_modules/
frontend/dist/
# Tauri 构建时生成的 schema 与平台文件
src-tauri/gen/

# ── 真实浏览器验收产物（本地产物，可再生，不提交）─────────
# frontend/scripts/check-*.mjs 写入的截图与量测 JSON（qa-artifacts/）：
# 体积大且每次运行都会重写，属生成物而非源码；需要留档时另行导出。
# 目录位于仓库根，与 target/、coverage.* 等同属"生成物"。
qa-artifacts/
